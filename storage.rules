rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isJpegUnder2MB() {
      return request.resource.size < 2 * 1024 * 1024 && request.resource.contentType == 'image/jpeg';
    }

    match /players/{file} {
      allow read;
      allow write: if request.auth != null && file == request.auth.uid + '.jpg' && isJpegUnder2MB();
    }

    match /teams/{uid}/{file} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == uid && isJpegUnder2MB();
    }
  }
}
