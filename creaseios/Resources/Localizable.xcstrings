    "welcomeSubtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live scores, full scorecards and your own matches, all in one place."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සජීවී ලකුණු, සම්පූර්ණ ලකුණු පුවරු සහ ඔබේම තරග, සියල්ල එකම තැනක."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நேரலை ஸ்கோர்கள், முழு ஸ்கோர்கார்டுகள் மற்றும் உங்கள் சொந்தப் போட்டிகள், அனைத்தும் ஒரே இடத்தில்."
          }
        }
      }
    },
