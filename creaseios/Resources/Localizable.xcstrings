    "authErrorCancelled" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verification was cancelled. Please try again."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "තහවුරු කිරීම අවලංගු විය. නැවත උත්සාහ කරන්න."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சரிபார்ப்பு ரத்துசெய்யப்பட்டது. மீண்டும் முயற்சிக்கவும்."
          }
        }
      }
    },
    "authErrorCodeExpired" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This code has expired. Tap \"Resend code\" to get a new one."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෙම කේතය කල් ඉකුත් වී ඇත. නව කේතයක් සඳහා \"කේතය නැවත යවන්න\" ඔබන්න."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தக் குறியீடு காலாவதியாகிவிட்டது. புதிய குறியீட்டைப் பெற \"குறியீட்டை மீண்டும் அனுப்பு\" என்பதைத் தட்டவும்."
          }
        }
      }
    },
    "authErrorInvalidCode" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That code is incorrect. Check the SMS and try again."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "එම කේතය වැරදියි. කෙටි පණිවිඩය පරීක්ෂා කර නැවත උත්සාහ කරන්න."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அந்தக் குறியீடு தவறானது. SMS ஐச் சரிபார்த்து மீண்டும் முயற்சிக்கவும்."
          }
        }
      }
    },
    "authErrorInvalidPhone" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That number doesn't look right. Check it and try again."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "එම අංකය නිවැරදි නොවන බව පෙනේ. පරීක්ෂා කර නැවත උත්සාහ කරන්න."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அந்த எண் சரியாகத் தெரியவில்லை. சரிபார்த்து மீண்டும் முயற்சிக்கவும்."
          }
        }
      }
    },
    "authErrorNetwork" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No internet connection. Check your connection and try again."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "අන්තර්ජාල සම්බන්ධතාවයක් නැත. සම්බන්ධතාවය පරීක්ෂා කර නැවත උත්සාහ කරන්න."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இணைய இணைப்பு இல்லை. இணைப்பைச் சரிபார்த்து மீண்டும் முயற்சிக்கவும்."
          }
        }
      }
    },
    "authErrorQuotaExceeded" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We can't send more codes right now. Please try again later."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "දැනට තවත් කේත යැවිය නොහැක. පසුව නැවත උත්සාහ කරන්න."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தற்போது மேலும் குறியீடுகளை அனுப்ப முடியாது. பின்னர் மீண்டும் முயற்சிக்கவும்."
          }
        }
      }
    },
    "authErrorSaveName" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't save your name. Please try again."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබේ නම සුරැකිය නොහැකි විය. නැවත උත්සාහ කරන්න."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் பெயரைச் சேமிக்க முடியவில்லை. மீண்டும் முயற்சிக்கவும்."
          }
        }
      }
    },
    "authErrorSendFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't send a code right now. Please try again in a few minutes."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "දැන් කේතයක් යැවිය නොහැකි විය. මිනිත්තු කිහිපයකින් නැවත උත්සාහ කරන්න."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இப்போது குறியீட்டை அனுப்ப முடியவில்லை. சில நிமிடங்களில் மீண்டும் முயற்சிக்கவும்."
          }
        }
      }
    },
    "authErrorTooManyRequests" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many attempts from this device. Please wait a while and try again."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෙම උපාංගයෙන් උත්සාහයන් වැඩියි. ටික වේලාවකින් නැවත උත්සාහ කරන්න."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தச் சாதனத்திலிருந்து அதிக முயற்சிகள். சிறிது நேரம் கழித்து மீண்டும் முயற்சிக்கவும்."
          }
        }
      }
    },
