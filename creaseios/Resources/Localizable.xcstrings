    "welcomeFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By continuing you agree to play fair and have fun."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඉදිරියට යාමෙන් ඔබ සාධාරණව ක්‍රීඩා කිරීමට සහ විනෝද වීමට එකඟ වේ."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தொடர்வதன் மூலம் நியாயமாக விளையாடவும் மகிழ்ச்சியாக இருக்கவும் ஒப்புக்கொள்கிறீர்கள்."
          }
        }
      }
    },
